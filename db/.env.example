# Supabase project settings (Project Settings -> API / Database in the Supabase dashboard)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string used by drizzle-kit (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Existing MongoDB, only needed to run migrate-from-mongo.ts once
MONGO_URI=mongodb://127.0.0.1:27017/gymlog

# Printed by find-user.ts once the real workout-history owner has signed up as a
# client for real -- needed by migrate-from-mongo.ts so it knows whose data this is.
OWNER_USER_ID=

# Where create-coach-invite.ts prints signup links against (defaults to http://localhost:5173 if unset)
APP_URL=
